# Copy this to .env and fill in real values.
# Never commit .env — it's in .gitignore. Only commit .env.example.

# --- Server ---
NODE_ENV=development
PORT=8787
# Comma-separated allow-list of frontend origins that can call this API.
# For local dev from the file://-opened app.html, keep 'null' in the list so
# the browser sends Origin: null. For production, put your real domain(s).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,null

# --- Upstream API keys (server-side only; NEVER sent to the browser) ---
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# GOOGLE_TRENDS_PROXY_BASE — removed in phase 2b.9 with the /api/trends
# route. trends.google.com started bot-blocking us (429) and no one in the
# UI was calling it. If you want a real trends signal later, add a paid
# provider (Glimpse, DataForSEO, etc) as a new service.

# --- Caching ---
# Cache TTL in seconds for upstream API responses. Keeps quota low.
CACHE_TTL_SECONDS=600

# --- Rate limits ---
# Window in ms. All buckets use the same window; just differ by "max".
RATE_LIMIT_WINDOW_MS=60000
# Legacy single ceiling — unused by the tiered limiter, kept so old envs
# don't break. The tiered limiter uses the three buckets below.
RATE_LIMIT_MAX=60
# /api/auth/login and /api/auth/signup, keyed by IP. Tight — protects
# against credential-stuffing.
RATE_LIMIT_AUTH_MAX=10
# Authenticated requests, keyed by user.id. Generous — legit users hit
# this during normal browsing.
RATE_LIMIT_AUTHED_MAX=240
# Anonymous non-auth requests, keyed by IP. Tight.
RATE_LIMIT_ANON_MAX=30

# --- Phase 2b.2: password policy ---
# zxcvbn score floor (0..4). Signup/change-password reject below this.
# 2 catches "Password1!" style passwords; 3 is aggressive.
ZXCVBN_MIN_SCORE=2
# Reject passwords that appear in HaveIBeenPwned more than this many
# times across breach corpora. 0 disables the check (useful for offline
# dev). Network errors fail open — a password is never rejected just
# because HIBP is unreachable.
HIBP_REJECT_THRESHOLD=10

# --- Logging ---
# 'info' in prod, 'debug' locally
LOG_LEVEL=info

# --- Phase 2b: database + sessions ---
# Local dev: Postgres on a Unix socket (default for Homebrew). For managed
# Postgres add ?sslmode=require.
DATABASE_URL=postgres://localhost/tx_rapper_tracker_dev

# Used to sign session cookies. MUST be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_48_random_bytes_at_least_32_chars_long

# Cookie name / domain. Leave domain blank for localhost.
SESSION_COOKIE_NAME=tx_sid
SESSION_COOKIE_DOMAIN=

# Session lifetime in seconds (14 days default).
SESSION_TTL_SECONDS=1209600

# Set to true in production (HTTPS). Must be false for http://localhost.
SESSION_COOKIE_SECURE=false

# Comma-separated emails allowed to hit /api/admin/*. Leave empty to 404
# every admin request (default). Add your own email to see audit_log +
# active sessions via admin.html.
ADMIN_EMAILS=

# Absolute path to the frontend checkout. Default auto-detects the sibling
# `../tx-rapper-tracker` directory — normal dev layout. Leave unset for that.
#FRONTEND_DIR=

# --- Password reset ---
# Public origin used when building reset links in the email. In dev this is
# localhost:8787 (the backend also serves the frontend). In prod set to
# your real https://... origin so the link works in a real inbox.
APP_BASE_URL=http://localhost:8787
# Token lifetime. 30 min is a good default — short enough to narrow the
# stolen-link window, long enough to forgive slow mail.
PASSWORD_RESET_TTL_MINUTES=30

# --- Mail ---
# From address on outgoing password-reset emails. Resend requires this
# domain to be verified on your Resend account; the dev console mailer
# just logs it.
MAIL_FROM=TX Rapper Tracker <no-reply@localhost>
# Optional. Set in prod to route email through Resend
# (https://resend.com). If empty, the backend falls back to the
# ConsoleMailer that logs each email and writes the latest to
# /tmp/last-reset-email.txt. Perfect for local testing.
RESEND_API_KEY=

# --- 2FA (Phase 2b.13: TOTP) ---
# AES-256-GCM key for encrypting user_totp.secret_encrypted at rest.
# 64 hex chars = 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank in dev to derive from SESSION_SECRET (LOUD warn in prod).
TOTP_ENC_KEY=
# Issuer label shown inside the user's authenticator app.
TOTP_ISSUER=TX Rapper Tracker

# --- 2FA (Phase 2b.14: WebAuthn / passkeys) ---
# Relying Party ID — bare hostname the user is on. Must match (or be a
# registrable suffix of) the origin. Localhost is the only value that
# works without HTTPS. In prod set to your tunnel/domain hostname.
WEBAUTHN_RP_ID=localhost
# Display name shown by the browser's WebAuthn UI ("Sign in to ___").
WEBAUTHN_RP_NAME=TX Rapper Tracker
# Comma-separated list of accepted browser origins. The first is canonical;
# additional entries cover the dev frontend on a different port. In prod,
# replace with your real https://... origin.
WEBAUTHN_ORIGINS=http://localhost:8787,http://localhost:8080

# --- Stripe payments (Phase 2c scaffolding) -----------------------------
# Live (sk_live_…) or test (sk_test_…) secret key. LEAVE BLANK to disable
# payments — the webhook receiver returns 503, getStripe() throws, and
# nothing else in the app touches Stripe. Safe default for dev.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Required when STRIPE_SECRET_KEY is set.
# Get this from the Stripe Dashboard webhook config, or `stripe listen`
# during local development.
STRIPE_WEBHOOK_SECRET=
# Default (single-tier) price id. Phase 2e.A made this a back-compat
# fallback — prefer STRIPE_PRICE_PRO + STRIPE_PRICE_PREMIUM below, which
# get seeded into pricing_tiers.stripe_price_id by
# `node scripts/seed-pricing-tiers.js`. The SQL view (active_user_plan)
# resolves a subscription's tier slug via that table; only-PRICE_ID
# subscriptions are gated as 'paid' but show up with rank=99 (unmapped).
STRIPE_PRICE_ID=
# --- Phase 2e.A: per-tier price ids -------------------------------------
# Create one Stripe Price per tier in the Dashboard, paste the
# `price_…` ids here, then run:
#   node scripts/seed-pricing-tiers.js
# (Or pass them as flags: --pro <id> --premium <id>.) The seeder UPSERTs
# pricing_tiers.stripe_price_id so the view + middleware can resolve
# 'pro' / 'premium' tiers.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Stripe API version pin — explicit so a future Stripe-side default
# bump can't silently shift our payload shapes. Leave at the default
# unless you've tested a newer version.
STRIPE_API_VERSION=2024-06-20

# --- Phase 3b: AI artist briefs (Claude API) ----------------------------
# Anthropic API key for the Premium-only artist-brief feature. Empty
# disables generation entirely — cache hits still serve, but cache
# misses return 503 with kind:'briefs_unconfigured'. Same posture as
# STRIPE_SECRET_KEY: feature flag by env, no code branch.
ANTHROPIC_API_KEY=
# Model id used for brief generation. Locked to Haiku 4.5 in v1; can
# be overridden in prod (e.g. to compare Sonnet quality without a code
# deploy). The cache key folds in the model id so a swap regenerates
# cleanly instead of serving Sonnet bytes against a Haiku fingerprint.
ANTHROPIC_BRIEF_MODEL=claude-haiku-4-5-20251001
# Hard timeout on the Claude call (ms). Past this we fail the route
# with a 504. 25s sits comfortably under Cloudflare's 100s origin
# timeout and gives Haiku room on cold-start.
ANTHROPIC_BRIEF_TIMEOUT_MS=25000
