# .env.production.example
# Template for a real deploy. Copy to .env on the prod host, fill in secrets,
# and NEVER commit the filled-in file. Every value here is deliberately chosen
# for a live environment — do not reuse dev settings.

# --- Server ---
NODE_ENV=production
# Bind port. If you're fronting with Cloudflare Tunnel, this stays localhost
# and only `cloudflared` on the same box talks to it.
PORT=8787

# Allow-list of browser origins for CORS.
# With the frontend served from the backend, same-origin fetches don't trip
# CORS at all — this list only matters if you point a separate host at the
# API. Leave it empty (or set to your own site origin) in prod.
CORS_ORIGINS=

# --- Upstream API keys (server-side only) ---
# Restrict this key in Google Cloud Console: HTTP referer = none (server-side),
# API restrictions = YouTube Data API v3 only.
YOUTUBE_API_KEY=your_prod_youtube_key_here
# GOOGLE_TRENDS_PROXY_BASE — removed in phase 2b.9 (unofficial endpoint
# started 429-ing). No replacement wired; see .env.example for notes.

# --- Caching ---
# 10 minutes is a good floor. Raise to reduce upstream quota burn.
CACHE_TTL_SECONDS=600

# --- Rate limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Harden login bucket in prod.
RATE_LIMIT_AUTH_MAX=8
RATE_LIMIT_AUTHED_MAX=240
RATE_LIMIT_ANON_MAX=30

# --- Password policy ---
ZXCVBN_MIN_SCORE=2
HIBP_REJECT_THRESHOLD=10

# --- Logging ---
# Structured JSON to stdout. Ship to your log aggregator (Grafana Loki, etc).
LOG_LEVEL=info

# --- Database ---
# Managed Postgres. sslmode=require is NOT optional.
# Example (Neon): postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/tx_rapper_tracker?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tx_rapper_tracker?sslmode=require

# --- Sessions ---
# Generate a fresh secret for prod — do NOT reuse dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_48_RANDOM_BYTES_HEX
# Use a distinct cookie name in prod so dev cookies can't collide.
SESSION_COOKIE_NAME=tx_sid
# Lock the cookie to your apex / app domain. Leave blank if single-origin.
SESSION_COOKIE_DOMAIN=tx-rapper-tracker.example.com
# 14 days.
SESSION_TTL_SECONDS=1209600
# MUST be true in prod — the cookie is Secure+HttpOnly+SameSite=Strict.
SESSION_COOKIE_SECURE=true

# Admins can read audit_log + active sessions via /api/admin/* and
# admin.html. Non-admins get 404 (route is not advertised).
ADMIN_EMAILS=you@yourdomain.com

# Absolute path to the frontend checkout. Default auto-detects the sibling
# `../tx-rapper-tracker` directory. Set explicitly if you deploy the frontend
# to a different location (e.g. a bundled /var/www/tx-rapper-tracker).
#FRONTEND_DIR=/var/www/tx-rapper-tracker

# --- Password reset ---
# Public HTTPS origin where users see the app. Reset links are built as
# $APP_BASE_URL/reset?token=... — this MUST be a real HTTPS URL in prod or
# the user's browser will refuse to send the session cookie back.
APP_BASE_URL=https://tx-rapper-tracker.example.com
# Token lifetime. 30 min is a sensible default for prod.
PASSWORD_RESET_TTL_MINUTES=30

# --- Mail (Resend) ---
# The verified sender domain on your Resend account.
MAIL_FROM=TX Rapper Tracker <no-reply@tx-rapper-tracker.example.com>
# Resend API key (https://resend.com/api-keys). Leaving this blank falls
# back to the ConsoleMailer — DO NOT ship without a real key in prod.
RESEND_API_KEY=re_your_prod_key_here
